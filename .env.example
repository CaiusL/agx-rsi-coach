# Copy to .env. Never commit account or model credentials.
AGX_BASE_URL=https://agx.cool
AGX_API_KEY=

# Choose: omlx | openai | openai_compatible | openrouter
LLM_PROVIDER=omlx
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=Qwen3.8-27B-4bit
LLM_API_KEY=

# Hosted OpenAI example (choose a model available to your account):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=your-model-id
# LLM_API_KEY=your-api-key

# OpenRouter example:
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=provider/model-id
# LLM_API_KEY=your-api-key

# Other Chat Completions services: openai_compatible + their /v1 base URL.
# Direct Anthropic Messages endpoints require a compatible gateway.
# Existing OMLX_BASE_URL/MODEL/API_KEY/TEMP/TOP_P/TOP_K also work for omlx
# when the corresponding LLM_* value is unset.
LLM_TEMP=0.3
LLM_TOP_P=0.95
LLM_TOP_K=20
# openai defaults to max_completion_tokens and omits sampling.
# Override only if your chosen model supports these:
# LLM_TOKEN_FIELD=max_completion_tokens
# LLM_SEND_SAMPLING=false
# LLM_FALLBACK_MODELS=

POLL_SECONDS=60
# 0 = no local cap. AGX still enforces its own quotas.
AGX_MAX_UPLOADS_PER_DAY=0

# Optional local counted-series boundary (timezone required).
# Trial logs remain available; local release file numbering restarts at v1.
# COUNTED_START_AT=2026-11-15T00:00:00+08:00

# Optional game/account overrides:
# RACING_A_KEY=
# RACING_B_KEY=
# FPS_A_KEY=
# FPS_B_KEY=

# Dashboard remains on this computer only.
UI_HOST=127.0.0.1
UI_TOKEN=
